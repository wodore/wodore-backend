{
  "version": 8,
  "id": "wd-terrain-test",
  "name": "Wodore Terrain Test (server-side contours)",
  "metadata": {
    "wodore:purpose": "A/B test style: server-side terrain (Martin postprocessing) vs client-side (raster-dem + maplibre-contour). Contours are the priority; hillshade is an unverified config stub. See _work/261008_martin_terrain_postprocessing.md.",
    "wodore:notes": "Tile URLs are relative: fetch this style via the martin origin to test direct serving, or via the nginx terrain cache (X-Cache-Status: HIT/MISS) to test warm/cold proxy_cache."
  },
  "glyphs": "/font/{fontstack}/{range}.pbf",
  "sources": {
    "contours": {
      "type": "vector",
      "tiles": ["/contours/{z}/{x}/{y}"],
      "maxzoom": 15,
      "attribution": "<a href='https://mapterhorn.com/attribution'>Mapterhorn</a>"
    },
    "hillshade": {
      "type": "raster",
      "tiles": ["/hillshade/{z}/{x}/{y}"],
      "tileSize": 512,
      "maxzoom": 15,
      "attribution": "<a href='https://registry.opendata.aws/terrain-tiles/'>AWS Terrain Tiles</a>"
    }
  },
  "layers": [
    {
      "id": "background",
      "type": "background",
      "paint": {
        "background-color": "#F2EDE0"
      }
    },
    {
      "id": "hillshade",
      "type": "raster",
      "source": "hillshade",
      "paint": {
        "raster-opacity": 0.6,
        "raster-resampling": "linear"
      }
    },
    {
      "id": "contour-lines",
      "type": "line",
      "source": "contours",
      "source-layer": "contour",
      "layout": {
        "line-join": "round"
      },
      "paint": {
        "line-color": [
          "case",
          ["==", ["get", "major"], true],
          "#96755B",
          "#B8A98F"
        ],
        "line-width": [
          "interpolate",
          ["linear"],
          ["zoom"],
          11,
          ["case", ["==", ["get", "major"], true], 1, 0.6],
          15,
          ["case", ["==", ["get", "major"], true], 1.8, 1.1]
        ],
        "line-blur": 0.25,
        "line-opacity": 0.85
      }
    },
    {
      "id": "contour-labels",
      "type": "symbol",
      "source": "contours",
      "source-layer": "contour",
      "filter": ["==", ["get", "major"], true],
      "layout": {
        "symbol-placement": "line",
        "text-field": [
          "number-format",
          ["get", "ele"],
          {
            "max-fraction-digits": 0
          }
        ],
        "text-font": ["Noto Sans Regular"],
        "text-size": ["interpolate", ["linear"], ["zoom"], 11, 9, 15, 11],
        "text-rotation-alignment": "map",
        "symbol-spacing": 220,
        "text-letter-spacing": 0.05
      },
      "paint": {
        "text-color": "#96755B",
        "text-halo-color": "#F2EDE0",
        "text-halo-width": 1.2
      }
    }
  ]
}
