# Single-origin tile router: martin (DB vector tiles, sprites, fonts,
# terrain) + the mapproxy raster facades behind ONE port — the same
# /raster/* contract the prod edge serves (see burginfra's martin
# nginx-cache tier). MARTIN_TILE_URL (default http://localhost:8075)
# points here, so the style fixtures' absolutized /raster/tiles/... URLs
# work out of the box with plain `docker compose up`.
#
# Rendered by the official nginx image's envsubst-on-templates feature
# (/etc/nginx/templates/*.template -> /etc/nginx/conf.d/). Plain nginx
# runtime vars ($http_host, no braces) are left untouched.
server {
    listen 80 default_server;

    # Re-resolve upstreams every 10s via Docker's embedded DNS —
    # plain proxy_pass caches the IP for nginx's lifetime, so a
    # restarted backend would 502 until the router restarts.
    resolver 127.0.0.11 valid=10s ipv6=off;

    # Stable raster facade: /raster/* -> the mapproxy backend (served
    # under its internal /mapproxy/ prefix). Swap the upstream to
    # replace the implementation without changing any client URL.
    location /raster/ {
        # set BEFORE the rewrite: `break` ends the rewrite phase, and
        # set (a rewrite-module directive) after it would never run
        set $mapproxy_upstream http://${MAPPROXY_UPSTREAM};
        rewrite ^/raster/(.*)$ /mapproxy/$1 break;
        proxy_pass $mapproxy_upstream;
        # Browser cache: tiles are stable; the styles' ?v=N param busts
        # (new query string = new cache key). mapproxy's own shorter
        # header is hidden so one clean immutable header remains.
        proxy_hide_header Cache-Control;
        add_header Cache-Control "public, max-age=604800, immutable" always;
        proxy_http_version 1.1;
        proxy_set_header Host $http_host;
    }

    location / {
        set $martin_upstream http://${MARTIN_UPSTREAM};
        proxy_pass $martin_upstream;
        proxy_set_header Host $http_host;
        proxy_set_header X-Forwarded-Host $http_host;
    }
}
