"(SAC, HRS, ...):"
msgstr "Bettenverfügbarkeit je Hütte und Tag, aggregiert aus Buchungsquellen\n(SAC, HRS, ...):"

#: server/templates/txt/llms.txt:52
msgid "One hut, next 7 days (JSON):"
msgstr "Eine Hütte, die nächsten 7 Tage (JSON):"

