#: server/templates/txt/llms.txt:41
#, python-format
msgid ""
"By map area: filter the hut/place listings to a bounding box with\n"
"  bbox=minLon,minLat,maxLon,maxLat (WGS84) — e.g.\n"
"  %(api_base)s/v1/huts/huts.geojson?bbox=7.6,45.9,8.1,46.2\n"
"  (accepted on hut search, hut list, both GeoJSON dumps and place\n"
"  search; paginate with offset and limit)"
msgstr "Nach Kartenbereich: die Hütten-/Ortslisten mit einer Bounding Box filtern über\n  bbox=minLon,minLat,maxLon,maxLat (WGS84) — z. B.\n  %(api_base)s/v1/huts/huts.geojson?bbox=7.6,45.9,8.1,46.2\n  (akzeptiert bei Hüttensuche, Hüttenliste, beiden GeoJSON-Dumps und der\n  Ortssuche; Paginierung mit offset und limit)"

