{
  "worktree": {
    "setup": [
      "workz sync --isolated --quiet \"$PASEO_WORKTREE_PATH\"",
      "scripts/lane-venv.sh",
      "scripts/lane-db.sh create",
      "scripts/sync-martin.sh"
    ],
    "teardown": ["scripts/lane-martin.sh stop", "scripts/lane-db.sh drop"],
    "servicePorts": { "range": "3450-3499" }
  },
  "scripts": {
    "test": { "command": "scripts/lane-run.sh .venv/bin/pytest" },
    "migrate": {
      "command": "scripts/lane-run.sh .venv/bin/python manage.py migrate"
    },
    "martin:start": { "command": "scripts/lane-martin.sh start" },
    "martin:stop": { "command": "scripts/lane-martin.sh stop" },
    "api": {
      "type": "service",
      "command": "scripts/lane-run.sh .venv/bin/python manage.py runserver $PASEO_PORT"
    }
  }
}
